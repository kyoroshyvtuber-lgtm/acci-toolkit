#!/usr/bin/env bash
# Orchestrator-only GitHub CLI. The token lives in $ACCI_HOME/secrets (0700) and is hidden from
# every project command by a mount namespace; output is redacted.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
acci_find_gh || exit $?
set -o pipefail
"$ACCI_GH_BIN" "$@" 2>&1 | sed -E 's/(gh[pousr]_|github_pat_)[A-Za-z0-9_]+/[REDACTED]/g'
