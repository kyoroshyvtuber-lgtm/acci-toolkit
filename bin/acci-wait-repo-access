#!/usr/bin/env bash
# Administrative helper: only run after explicit owner approval to create a private repo.
# Poll until the owner widens access, then create the private test repo once.
# Usage: acci-wait-repo-access OWNER/REPO [seconds=900] [logfile]
# Never prints the token; stops on success (201) or "already exists" (422).
set -u
REPO=${1:?OWNER/REPO}; LIMIT=${2:-900}; LOG=${3:-/dev/stdout}
NAME=${REPO#*/}
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
acci_find_gh || exit $?
G=$ACCI_GH_BIN
end=$(( $(date +%s) + LIMIT ))
while [ "$(date +%s)" -lt "$end" ]; do
  # owner may also create the repo manually and grant the token access only to it
  if "$G" api "repos/$REPO" --jq .full_name >/dev/null 2>&1; then
    echo "$(date -u +%FT%TZ) ACCESSIBLE $REPO" >>"$LOG"; exit 0; fi
  out=$("$G" api -X POST user/repos -f name="$NAME" -F private=true \
        -f description="ACCI pipeline test lab" 2>&1); rc=$?
  ts=$(date -u +%FT%TZ)
  if [ $rc -eq 0 ]; then echo "$ts CREATED $REPO (private)" >>"$LOG"; exit 0; fi
  if grep -q "name already exists" <<<"$out"; then echo "$ts EXISTS $REPO" >>"$LOG"; exit 0; fi
  echo "$ts WAIT $(head -1 <<<"$out" | sed -E 's/(github_pat_|gh[pousr]_)[A-Za-z0-9_]+/\1***/g')" >>"$LOG"
  sleep 30
done
echo "$(date -u +%FT%TZ) TIMEOUT" >>"$LOG"; exit 2
